#most popular amenities

top_amenities <- listings_clean %>%
  pull(amenities_clean) %>%
  str_split(",\\s*") %>%
  unlist() %>%
  str_trim() %>%
  tibble(amenity = .) %>%
  filter(amenity != "") %>%
  count(amenity, sort = TRUE) %>%
  mutate(pct_of_listings = round(n / nrow(listings_clean) * 100, 1))

top_amenities %>% print(n = 20)

#ranking of amenities importance on revenue

candidate_amenities <- top_amenities %>%
  filter(pct_of_listings >= 10, pct_of_listings <= 85) %>%
  pull(amenity)
length(candidate_amenities)

amenity_impact <- map_dfr(candidate_amenities, function(a) {
  has_it <- str_detect(listings_clean$amenities_clean, fixed(a))
  tibble(
    amenity = a,
    n_with = sum(has_it, na.rm = TRUE),
    n_without = sum(!has_it, na.rm = TRUE),
    median_revenue_with = median(listings_clean$estimated_revenue_l365d[has_it], na.rm = TRUE),
    median_revenue_without = median(listings_clean$estimated_revenue_l365d[!has_it], na.rm = TRUE)
  ) %>%
    mutate(
      revenue_diff = median_revenue_with - median_revenue_without,
      pct_lift = round((median_revenue_with / median_revenue_without - 1) * 100, 1)
    )
})

amenity_impact %>%
  filter(n_with >= 200, n_without >= 200) %>%  # ensure both groups have a reasonable sample
  arrange(desc(revenue_diff)) %>%
  print(n = 20)

