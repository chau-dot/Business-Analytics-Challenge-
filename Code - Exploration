# Share of all listings by LGA (Melbourne 32.6%, Port Phillip 10.9%)
listings_clean %>%
  count(neighbourhood_cleansed, sort = TRUE) %>%
  mutate(pct_of_market = round(n / sum(n) * 100, 1)) %>% print(n = Inf)

# Median nights booked and price by LGA (Yarra Ranges 54 nights; Bayside price 329 but 6 nights)
listings_clean %>%
  group_by(neighbourhood_cleansed) %>%
  summarise(n = n(), median_nights = median(estimated_occupancy_l365d, na.rm = TRUE),
