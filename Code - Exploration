# Entire-home median revenue by LGA with at least 100 entire homes
listings_clean %>%
  filter(room_type == "Entire home/apt") %>%
  group_by(neighbourhood_cleansed) %>%
  summarise(n = n(), median_revenue = median(estimated_revenue_l365d, na.rm = TRUE)) %>%
