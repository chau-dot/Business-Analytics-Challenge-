# Amenities: most common amenities and median-revenue difference with/without each
top_amenities <- listings_clean %>%
  pull(amenities_clean) %>% str_split(",\\s*") %>% unlist() %>% str_trim() %>%
  tibble(amenity = .) %>% filter(amenity != "") %>%
  count(amenity, sort = TRUE) %>%
  mutate(pct_of_listings = round(n / nrow(listings_clean) * 100, 1))
top_amenities %>% print(n = 20)

candidate_amenities <- top_amenities %>%
  filter(pct_of_listings >= 10, pct_of_listings <= 85) %>% pull(amenity)
amenity_impact <- map_dfr(candidate_amenities, function(a) {
  has_it <- str_detect(listings_clean$amenities_clean, fixed(a))
  tibble(amenity = a, n_with = sum(has_it), n_without = sum(!has_it),
         median_revenue_with    = median(listings_clean$estimated_revenue_l365d[has_it],  na.rm = TRUE),
         median_revenue_without = median(listings_clean$estimated_revenue_l365d[!has_it], na.rm = TRUE)) %>%
    mutate(revenue_diff = median_revenue_with - median_revenue_without)
})
amenity_impact %>% filter(n_with >= 200, n_without >= 200) %>%
  arrange(desc(revenue_diff)) %>% print(n = 20)
# Single amenities mostly proxy for "a well-equipped listing run by a Superhost":
listings_clean %>%
  mutate(has_wine_glasses = str_detect(amenities_clean, fixed("Wine glasses"))) %>%
  group_by(has_wine_glasses) %>%
  summarise(mean_amenity_count = mean(amenities_count), pct_superhost = round(mean(host_is_superhost, na.rm = TRUE) * 100, 1))

