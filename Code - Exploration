library(tidyverse)
library(scales)
library(corrplot)

if (!exists("listings_clean")) listings_clean <- readRDS("listings_clean.rds")
dir.create("figures_r", showWarnings = FALSE)

# ---------- A. Revenue status and data quality (Section 2) --------------------
# Revenue is price x nights booked (correlation should be 1)
cor(listings_clean$estimated_revenue_l365d,
    listings_clean$estimated_occupancy_l365d * listings_clean$price_num,
    use = "complete.obs")

# Missing, zero and positive revenue: 6,360 | 4,476 | 14,457 of 25,293
listings_clean %>%
  summarise(total            = n(),
            missing_revenue  = sum(is.na(estimated_revenue_l365d)),
            zero_revenue     = sum(estimated_revenue_l365d == 0, na.rm = TRUE),
            positive_revenue = sum(estimated_revenue_l365d > 0, na.rm = TRUE)) %>%
  mutate(across(-total, ~ round(.x / total * 100, 1), .names = "pct_{.col}"))

# Listings with no reviews: 4,290, all with zero revenue
listings_clean %>%
  mutate(has_reviews = number_of_reviews > 0) %>%
  group_by(has_reviews) %>%
  summarise(n = n(), pct_zero_revenue = round(mean(estimated_revenue_l365d == 0, na.rm = TRUE) * 100, 1))

# Do the 6,360 listings with no price differ from the rest?
listings_clean %>%
  mutate(price_missing = is.na(price_num)) %>%
  group_by(price_missing) %>%
  summarise(n = n(),
            median_occupancy = median(estimated_occupancy_l365d, na.rm = TRUE),
            median_reviews   = median(number_of_reviews, na.rm = TRUE),
            pct_superhost    = round(mean(host_is_superhost, na.rm = TRUE) * 100, 1),
            pct_entire_home  = round(mean(room_type == "Entire home/apt") * 100, 1))

# Room types left out of the model: hotel 52 (12 earning), shared 217 (92 earning)
listings_clean %>%
  filter(room_type %in% c("Shared room", "Hotel room")) %>%
  group_by(room_type) %>%
  summarise(n = n(), earning = sum(estimated_revenue_l365d > 0, na.rm = TRUE),
            median_revenue = median(estimated_revenue_l365d, na.rm = TRUE))

# Model sample (14,353) and its data quality
q <- listings_clean %>%
  filter(room_type %in% c("Entire home/apt", "Private room"),
         estimated_revenue_l365d > 0, estimated_occupancy_l365d > 0, price_num > 0)
nrow(q)                                                       # 14,353
quantile(q$price_num, c(0, .01, .5, .99, 1))                  # 30, 57.14, 252, 1,124.48, 23,149.5
quantile(q$estimated_revenue_l365d, c(0, .01, .5, .99, 1))    # 204, 591, 15,804, 125,402, 3,623,832
c(nights_over_365 = sum(q$estimated_occupancy_l365d > 365),   # all 0
  zero_guests     = sum(q$accommodates < 1),
  duplicate_ids   = sum(duplicated(q$id)))
q %>% arrange(desc(estimated_revenue_l365d)) %>%              # eight largest: $5,671-$23,150 a night
  select(id, room_type, accommodates, price_num, estimated_occupancy_l365d, estimated_revenue_l365d) %>%
  head(8)

# On the log scale, price vs nights booked (0.48 and 0.88)
q %>%
  summarise(n = n(),
            cor_logrev_logprice = cor(log(estimated_revenue_l365d), log(price_num)),
            cor_logrev_lognights = cor(log(estimated_revenue_l365d), log(estimated_occupancy_l365d)),
            cor_logprice_lognights = cor(log(price_num), log(estimated_occupancy_l365d)))

# ---------- B. Superhost comparison (Table 2, Figure 1) -----------------------
# Medians: revenue 3,083 vs 23,400; nights 0 vs 90; rating 4.79 vs 4.91
listings_clean %>%
  group_by(host_is_superhost) %>%
  summarise(n = n(), pct = round(n() / nrow(listings_clean) * 100, 1),
            mean_price = round(mean(price_num, na.rm = TRUE)),                  # 313 vs 320
            median_revenue = median(estimated_revenue_l365d, na.rm = TRUE),
            median_nights  = median(estimated_occupancy_l365d, na.rm = TRUE),
            median_rating  = median(review_scores_rating, na.rm = TRUE),
            median_amenities = median(amenities_count, na.rm = TRUE)) %>%       # about 32 vs 45
  as.data.frame()

plot_df <- listings_clean %>%
  mutate(host_group = factor(ifelse(host_is_superhost, "Superhost", "Non-Superhost"),
                             levels = c("Non-Superhost", "Superhost"))) %>%
  group_by(host_group) %>%
  summarise(median_revenue = median(estimated_revenue_l365d, na.rm = TRUE),
            median_nights  = median(estimated_occupancy_l365d, na.rm = TRUE), .groups = "drop")

cols <- c("Non-Superhost" = "#64748B", "Superhost" = "#0C6DCD")
fig1a <- ggplot(plot_df, aes(host_group, median_revenue, fill = host_group)) +
  geom_col(width = 0.6) +
  geom_text(aes(label = dollar(floor(median_revenue + 0.5))), vjust = -0.5, size = 5, fontface = "bold") +
  scale_fill_manual(values = cols) +
  scale_y_continuous(labels = dollar_format(), expand = expansion(mult = c(0, 0.12))) +
  labs(title = "Median annual revenue (AUD)", x = NULL, y = NULL) +
  theme_minimal(base_size = 14) + theme(legend.position = "none", panel.grid.major.x = element_blank())
fig1b <- ggplot(plot_df, aes(host_group, median_nights, fill = host_group)) +
  geom_col(width = 0.6) +
  geom_text(aes(label = comma(median_nights)), vjust = -0.5, size = 5, fontface = "bold") +
  scale_fill_manual(values = cols) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.12))) +
  labs(title = "Median nights booked, last 365 days", x = NULL, y = NULL) +
  theme_minimal(base_size = 14) + theme(legend.position = "none", panel.grid.major.x = element_blank())
fig1a; fig1b
ggsave("figures_r/fig1a_median_revenue.png", fig1a, width = 6, height = 4.5, dpi = 200)
ggsave("figures_r/fig1b_median_nights.png",  fig1b, width = 6, height = 4.5, dpi = 200)

# ---------- C. Room type and location (Figure 2) ------------------------------
# Entire homes 73.3% of listings, mean revenue $24,961; private rooms $4,034
listings_clean %>%
  group_by(room_type) %>%
  summarise(n = n(), pct = round(n() / nrow(listings_clean) * 100, 1),
            median_price = median(price_num, na.rm = TRUE),
