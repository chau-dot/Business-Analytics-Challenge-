library(tidyverse)
library(scales)

if (!exists("listings_clean")) listings_clean <- readRDS("listings_clean.rds")
dir.create("figures_r", showWarnings = FALSE)

# ---------- 1. Model sample -----------------------------------------------------
# Entire homes and private rooms with positive revenue, nights booked and price
model_base <- listings_clean %>%
  filter(room_type %in% c("Entire home/apt", "Private room"),
         estimated_revenue_l365d > 0, estimated_occupancy_l365d > 0, price_num > 0) %>%
  mutate(
    log_revenue = log(estimated_revenue_l365d),
    log_price   = log(price_num),
    log_nights  = log(estimated_occupancy_l365d),
    superhost   = factor(ifelse(host_is_superhost, "Yes", "No"), levels = c("No", "Yes")),
    room_type   = factor(room_type, levels = c("Private room", "Entire home/apt")),
    min_stay    = cut(minimum_nights, breaks = c(0, 1, 2, 3, Inf),
                      labels = c("1 night", "2 nights", "3 nights", "4+ nights")),
    lga         = fct_relevel(fct_lump_min(factor(neighbourhood_cleansed), min = 100,
                                           other_level = "Other"), "Melbourne")
  )

model_df2 <- model_base %>%
  select(log_revenue, log_price, log_nights, superhost, room_type, accommodates,
         amenities_count, hosts_time_as_host_years, min_stay, lga) %>%
  drop_na()
cat("Rows used:", nrow(model_df2), "\n")                       # 14,353

# ---------- 2. Why bathrooms were dropped ---------------------------------------
# Adding bathrooms leaves 13,201 listings, and bathrooms is not significant (p = 0.82)
model_df_bath <- model_base %>%
  select(log_revenue, superhost, room_type, accommodates, bathrooms, amenities_count,
         hosts_time_as_host_years, min_stay, lga) %>%
  drop_na()
nrow(model_df_bath)                                            # 13,201
fit_bath <- lm(log_revenue ~ superhost + room_type + accommodates + bathrooms + amenities_count +
                 hosts_time_as_host_years + min_stay + lga, data = model_df_bath)
round(coef(summary(fit_bath))["bathrooms", ], 3)

# ---------- 3. Train/test split and the three models ----------------------------
set.seed(123)
idx2   <- sample(seq_len(nrow(model_df2)), size = floor(0.8 * nrow(model_df2)))
train2 <- model_df2[idx2, ]                                    # 11,482
test2  <- model_df2[-idx2, ]                                   # 2,871

# Same predictors, three outcomes: revenue = price x nights, so each effect on
# revenue splits exactly into a price part and a nights-booked part
rhs2 <- "superhost + room_type + accommodates + amenities_count + hosts_time_as_host_years + min_stay + lga"
fit_rev2    <- lm(as.formula(paste("log_revenue ~", rhs2)), data = train2)
fit_price2  <- lm(as.formula(paste("log_price ~",   rhs2)), data = train2)
fit_nights2 <- lm(as.formula(paste("log_nights ~",  rhs2)), data = train2)

# ---------- 4. Results table (Table 3, Appendix A) ------------------------------
ci <- confint(fit_rev2)
out <- tibble(
  term       = names(coef(fit_rev2)),
  pct_effect = round((exp(coef(fit_rev2)) - 1) * 100, 1),
  ci_low     = round((exp(ci[, 1]) - 1) * 100, 1),
  ci_high    = round((exp(ci[, 2]) - 1) * 100, 1),
  p_value    = round(coef(summary(fit_rev2))[, "Pr(>|t|)"], 3),
  via_price  = round(coef(fit_price2), 3),
  via_nights = round(coef(fit_nights2), 3)
) %>% filter(term != "(Intercept)")
print(out, n = Inf)
write_csv(out, "model_full_results.csv")

# Test-set fit: R2 0.42, RMSE 0.98, MAE 0.78 (log scale)
r2 <- function(a, p) 1 - sum((a - p)^2) / sum((a - mean(a))^2)
pred2 <- predict(fit_rev2, test2)
c(RMSE_log = sqrt(mean((test2$log_revenue - pred2)^2)),
  MAE_log  = mean(abs(test2$log_revenue - pred2)),
  R2_test  = r2(test2$log_revenue, pred2))

# ---------- 5. Diagnostics (Appendix B) -----------------------------------------
diag_df <- tibble(fitted = fitted(fit_rev2), resid = resid(fit_rev2))
p1 <- ggplot(diag_df, aes(fitted, resid)) +
  geom_point(alpha = 0.15) + geom_hline(yintercept = 0, colour = "red") + geom_smooth(se = FALSE) +
  labs(title = "Residuals vs fitted values", x = "Fitted log revenue", y = "Residual") +
  theme_minimal(base_size = 14)
p2 <- ggplot(diag_df, aes(sample = resid)) +
  stat_qq(alpha = 0.2) + stat_qq_line(colour = "red") +
  labs(title = "Normal QQ plot of residuals", x = "Theoretical quantiles", y = "Sample quantiles") +
  theme_minimal(base_size = 14)
p1; p2
ggsave("figures_r/figA1_residuals.png", p1, width = 6, height = 4.5, dpi = 200)
ggsave("figures_r/figA2_qq.png",        p2, width = 6, height = 4.5, dpi = 200)

# Multicollinearity: variance inflation factors (maximum 1.42, room type)
X <- model.matrix(fit_rev2)[, -1]
vifs <- diag(solve(cor(X)))
round(sort(vifs, decreasing = TRUE)[1:8], 2)

# ---------- 6. Sensitivity: refit without the extreme 1% tails of price (Appendix C)
keep <- model_df2$log_price >= quantile(model_df2$log_price, .01) &
        model_df2$log_price <= quantile(model_df2$log_price, .99)
f_full <- lm(as.formula(paste("log_revenue ~", rhs2)), data = model_df2)
f_trim <- lm(as.formula(paste("log_revenue ~", rhs2)), data = model_df2[keep, ])
key <- c("superhostYes", "room_typeEntire home/apt", "min_stay3 nights", "lgaYarra", "amenities_count")
round(cbind(full    = (exp(coef(f_full)[key]) - 1) * 100,
            trimmed = (exp(coef(f_trim)[key]) - 1) * 100), 1)

# ---------- 7. Price part and nights part (Figure 4 in the report) --------------
terms  <- c("superhostYes", "room_typeEntire home/apt", "min_stay3 nights", "accommodates")
labels <- c("Superhost", "Entire home", "3-night minimum", "Extra guest")

# Check: the two log parts add up exactly to the effect on revenue (expect TRUE)
all.equal(unname(coef(fit_price2)[terms] + coef(fit_nights2)[terms]),
          unname(coef(fit_rev2)[terms]))

to_pct <- function(model) (exp(coef(model)[terms]) - 1) * 100
price_df  <- tibble(effect = factor(labels, levels = labels), pct = to_pct(fit_price2))
nights_df <- tibble(effect = factor(labels, levels = labels), pct = to_pct(fit_nights2))
print(price_df)    # about -3.3, +80.0, -1.3, +12.3
print(nights_df)   # about +119.9, +47.5, -35.9, -3.4

bar_chart <- function(df, fill_col, title, ylab) {
  ggplot(df, aes(effect, pct)) +
    geom_hline(yintercept = 0, colour = "grey40") +
    geom_col(fill = fill_col, width = 0.6) +
    geom_text(aes(label = sprintf("%+.0f%%", pct), vjust = ifelse(pct >= 0, -0.5, 1.4)),
              size = 5, fontface = "bold") +
    scale_y_continuous(expand = expansion(mult = c(0.15, 0.15))) +
    labs(title = title, x = "Factor", y = ylab) +
    theme_minimal(base_size = 14) + theme(panel.grid.major.x = element_blank())
}
chart_price  <- bar_chart(price_df,  "#F59E0B", "Price part: effect on average nightly price", "Effect on nightly price (%)")
chart_nights <- bar_chart(nights_df, "#0C6DCD", "Nights part: effect on nights booked", "Effect on nights booked (%)")
chart_price; chart_nights
ggsave("figures_r/fig4a_price_part.png",  chart_price,  width = 7, height = 4.5, dpi = 200)
ggsave("figures_r/fig4b_nights_part.png", chart_nights, width = 7, height = 4.5, dpi = 200)

# Same split in log points (alternative view)
decomp <- tibble(effect = factor(labels, levels = labels),
                 `Through price`         = coef(fit_price2)[terms],
                 `Through nights booked` = coef(fit_nights2)[terms]) %>%
  pivot_longer(-effect, names_to = "part", values_to = "log_points")
chart_log <- ggplot(decomp, aes(effect, log_points, fill = part)) +
  geom_hline(yintercept = 0, colour = "grey40") +
  geom_col(position = position_dodge(width = 0.75), width = 0.65) +
  geom_text(aes(label = sprintf("%.2f", log_points), vjust = ifelse(log_points >= 0, -0.5, 1.4)),
            position = position_dodge(width = 0.75), size = 4, fontface = "bold") +
  scale_fill_manual(values = c("Through price" = "#F59E0B", "Through nights booked" = "#0C6DCD")) +
  scale_y_continuous(expand = expansion(mult = c(0.12, 0.12))) +
  labs(title = "Price part vs nights part of each effect on revenue",
       x = "Factor", y = "Effect on log revenue (log points)", fill = NULL) +
  theme_minimal(base_size = 14) + theme(legend.position = "bottom", panel.grid.major.x = element_blank())
chart_log
ggsave("figures_r/fig4c_log_points.png", chart_log, width = 8, height = 4.8, dpi = 200)

# ---------- 8. Location effects relative to the CBD (Figure 5 in the report) ----
lga_tbl <- out %>%
  filter(str_starts(term, "lga")) %>%
  mutate(lga = str_remove(term, "^lga"),
         result = ifelse(ci_low > 0 | ci_high < 0, "Clearly different from CBD", "Not clearly different"))
table(lga_tbl$result)    # 27 comparisons: 4 not clearly different, 23 clearly below or above

lga_chart <- ggplot(lga_tbl, aes(pct_effect, reorder(lga, pct_effect), xmin = ci_low, xmax = ci_high, colour = result)) +
  geom_vline(xintercept = 0, linetype = "dashed", colour = "grey50") +
  geom_pointrange() +
  scale_colour_manual(values = c("Clearly different from CBD" = "#0C6DCD", "Not clearly different" = "#F59E0B")) +
  labs(title = "Revenue by LGA relative to the Melbourne CBD",
       subtitle = "Effect on annual revenue with 95% intervals, other factors held constant",
       x = "Effect on annual revenue vs Melbourne CBD (%)", y = "Local government area (LGA)", colour = NULL) +
  theme_minimal(base_size = 13) + theme(legend.position = "bottom")
lga_chart
ggsave("figures_r/fig5_lga_effects.png", lga_chart, width = 7.5, height = 7, dpi = 200)

# ---------- 9. Illustrative scenarios (Table 4) ---------------------------------
# Effects multiply on the revenue scale. Baseline = private room, non-Superhost,
# 1-night minimum, Melbourne CBD.
b <- coef(fit_rev2)
mult <- function(terms) round(exp(sum(b[terms])), 1)
tibble(
  scenario = c("Entire home, non-Superhost, 1-night min, CBD",
               "Entire home, Superhost standard, 1-night min, CBD",
               "Entire home, Superhost standard, 1-night min, Yarra",
               "Entire home, Superhost standard, 3-night min, Yarra",
               "Entire home, Superhost standard, 1-night min, Bayside"),
  times_baseline = c(mult("room_typeEntire home/apt"),                                         # 2.7
                     mult(c("room_typeEntire home/apt", "superhostYes")),                      # 5.6
                     mult(c("room_typeEntire home/apt", "superhostYes", "lgaYarra")),          # 6.9
                     mult(c("room_typeEntire home/apt", "superhostYes", "lgaYarra", "min_stay3 nights")),  # 4.4
                     mult(c("room_typeEntire home/apt", "superhostYes", "lgaBayside")))        # 4.0
)
